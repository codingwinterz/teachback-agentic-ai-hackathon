# fake = offline dev mode, no API calls (default). real = call the provider below.
# Real calls cost free-tier quota: use them for deliberate checks, recording, Demo Day.
LLM_MODE=fake
LLM_PROVIDER=gemini
# Free-tier models (ai.google.dev/gemini-api/docs/models, checked 2026-10-31).
# Flash-Lite is primary: ~4s per attempt. gemini-3.6-flash free tier is only 20 requests/day.
# Check daily limits per model at https://aistudio.google.com/rate-limit
LLM_MODEL=gemini-3.5-flash-lite
# Tried in order when the primary keeps returning 429/5xx/timeouts or its daily quota is gone.
LLM_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.8-flash
LLM_CALL_TIMEOUT_S=12
GEMINI_API_KEY=
DB_PATH=teachback.db

# Alternative provider:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=medium
# ANTHROPIC_API_KEY=
