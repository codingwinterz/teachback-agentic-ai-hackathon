LLM_PROVIDER=gemini
# Free-tier Flash models (ai.google.dev/gemini-api/docs/models, checked 2026-10-31).
# gemini-3.8-flash is newer but returned repeated 503 "high demand" on 2026-10-31.
LLM_MODEL=gemini-3.6-flash
# Tried in order when the primary keeps returning 429/500/503.
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite
GEMINI_API_KEY=
DB_PATH=teachback.db

# Alternative provider:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=medium
# ANTHROPIC_API_KEY=
