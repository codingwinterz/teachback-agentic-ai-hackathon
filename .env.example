# fake = offline dev mode, no API calls (default). real = call the provider below.
# Real calls cost free-tier quota: use them for deliberate checks, recording, Demo Day.
LLM_MODE=fake
LLM_PROVIDER=gemini
# Free-tier models (ai.google.dev/gemini-api/docs/models, checked 2026-10-31).
# Flash-Lite is primary: ~4s per attempt. gemini-3.6-flash free tier is only 20 requests/day.
# Check daily limits per model at https://aistudio.google.com/rate-limit
LLM_MODEL=gemini-3.5-flash-lite
# Tried in order when the primary keeps returning 429/5xx/timeouts or its daily quota is gone.
# A model whose 429 says to wait >60s (daily quota) is skipped until its quota resets.
# 3.6/3.8 Flash go last: ~20 requests/day on the free tier.
LLM_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.8-flash
LLM_CALL_TIMEOUT_S=12
# Study sessions: max AI requests per session (retries count), and seconds between requests
# (4s keeps under 15 requests/minute on Flash-Lite; only applied when LLM_MODE=real).
SESSION_MAX_CALLS=30
SESSION_MIN_CALL_INTERVAL_S=4
GEMINI_API_KEY=
DB_PATH=teachback.db

# Alternative provider:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=medium
# ANTHROPIC_API_KEY=
